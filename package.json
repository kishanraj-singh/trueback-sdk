{
  "name": "trueback-sdk",
  "version": "1.0.0",
  "description": "Trueback SDK for your app",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup"
  },
  "keywords": [
    "feedback",
    "sdk",
    "trueback",
    "trueback-sdk"
  ],
  "author": "Kishan Raj Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kishanraj-singh/trueback-sdk"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  }
}
